      "idEvent": "2495026",
      "idAPIfootball": null,
      "strTimestamp": "2026-07-03T09:00:00",
      "strEvent": "Shanghai ePrix Free Practice 1",
      "strEventAlternate": null,
      "strFilename": "Formula E 2026-07-04 Shanghai ePrix Free Practice 1",
      "strSport": "Motorsport",
      "idLeague": "4371",
